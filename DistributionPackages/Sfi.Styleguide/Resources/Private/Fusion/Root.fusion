# This page should extend main website page, to inherit styles
prototype(Sfi.Styleguide:StyleguidePage) {
	body {
		templatePath = 'resource://Sfi.Styleguide/Private/Templates/NodeTypes/Category.html'

		title = ${node.properties.title}

		menu = Neos.Neos:Menu
		menu {
			 entryLevel = 2
		}

		subMenu = Neos.Neos:Menu
		subMenu {
			 entryLevel = 3
			 maximumLevels = 2
		}

		content = Neos.Neos:ContentCollectionRenderer
	}
	@cache {
		mode = 'cached'
		entryIdentifier {
			node = ${node}
			editPreviewMode = ${editPreviewMode}
		}
		entryTags {
			1 = ${Neos.Caching.nodeTag(documentNode)}
			2 = ${Neos.Caching.descendantOfTag(documentNode)}
		}
	}
}

prototype(Sfi.Styleguide:StyleguidePageItem) < prototype(Sfi.Styleguide:StyleguidePage) {
	body {
		templatePath = 'resource://Sfi.Styleguide/Private/Templates/NodeTypes/Blank.html'
	}
}

prototype(Sfi.Styleguide:SubCategory) < prototype(Neos.Neos:Content) {
	templatePath = 'resource://Sfi.Styleguide/Private/Templates/NodeTypes/SubCategory.html'
	content = Neos.Neos:ContentCollectionRenderer
}

prototype(Sfi.Styleguide:Item) < prototype(Neos.Neos:Content) {
	templatePath = 'resource://Sfi.Styleguide/Private/Templates/NodeTypes/Item.html'
	statusTrack = ${q(node).property('statusTrack')}
	statusDevelopment = ${q(node).property('statusDevelopment')}
	statusDesignMobile = ${q(node).property('statusDesignMobile')}
	statusDesignDesktop = ${q(node).property('statusDesignDesktop')}
	content = Neos.Neos:ContentCollectionRenderer
}


root.styleguide1 {
	condition = ${q(node).is('[instanceof Sfi.Styleguide:Category]')}
	type = 'Sfi.Styleguide:StyleguidePage'
}
root.styleguide2 {
	condition = ${q(node).is('[instanceof Sfi.Styleguide:SubCategory]')}
	type = 'Sfi.Styleguide:StyleguidePage'
}
root.styleguide3 {
	condition = ${q(node).is('[instanceof Sfi.Styleguide:Item]')}
	type = 'Sfi.Styleguide:StyleguidePageItem'
}
