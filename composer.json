{
    "name": "sfi/sfi-distr",
    "description": "Neos Distribution for Sfi.ru",
    "config": {
        "vendor-dir": "Packages/Libraries",
        "bin-dir": "bin",
        "allow-plugins": {
            "neos/composer-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "DistributionPackages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "aertmann/history": "dev-neos84",
        "flownative/aws-s3": "^2.8",
        "flowpack/cachebuster": "^1.0",
        "flowpack/jobqueue-common": "^3.0",
        "flowpack/mustache": "dev-neos84",
        "flowpack/nodetemplates": "^2.2",
        "mustache/mustache": "^2.13",
        "neos/flow": "~8.4.0",
        "neos/form": "^5.4",
        "neos/fusion-afx": "~8.4.0",
        "neos/googleanalytics": "^3.4",
        "neos/neos": "~8.4.8",
        "neos/neos-ui": "~8.4.0",
        "neos/nodetypes": "~8.4.0",
        "neos/redirecthandler": "^5.1",
        "neos/redirecthandler-databasestorage": "^5.0",
        "neos/redirecthandler-neosadapter": "^4.3.4",
        "neos/swiftmailer": "^7.4",
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "psmb/bookmarklet": "dev-neos84",
        "psmb/createnodebutton": "dev-neos84",
        "psmb/footnote": "dev-neos84",
        "psmb/newsletter": "dev-neos84",
        "psmb/registry": "^2.1.4",
        "psmb/term": "dev-neos84",
        "sfi/grid": "dev-neos84",
        "sfi/styleguide": "dev-neos84",
        "ttree/dimensionkeeper": "^1.2.1",
        "yeebase/graylog": "dev-neos84"
    },
    "scripts": {
        "post-update-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
        "post-install-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
        "post-package-update": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",
        "post-package-install": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",
        "test": "bash Build/Tests/run.sh"
    },
    "require-dev": {
        "behat/behat": "^3.29",
        "neos/buildessentials": "~8.4.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Flowpack\\Listable\\": "Packages/Application/Flowpack.Listable/Classes",
            "Sfi\\Sber\\": "Packages/Application/Sfi.Sber/Classes/",
            "Sfi\\Umo\\": "Packages/Application/Sfi.Umo/Classes/"
        },
        "psr-0": {
            "Sfi\\News": "Packages/Application/Sfi.News/Classes",
            "Sfi\\Shared": "Packages/Application/Sfi.Shared/Classes",
            "Sfi\\Sfi": "Packages/Sites/Sfi.Sfi/Classes"
        }
    }
}
