prototype(Sfi.Sfi:PaperWithAuthor.AuthorInfoArticlesList) < prototype(Neos.Fusion:Loop) {
    @context.author = ${author || node.properties.author}
    @context.nodeType = 'Sfi.Sfi:PaperWithAuthor'
    @context.listTitle = ${Translation.translate('otherArticlesByAuthor', null, [], null, 'Sfi.Sfi')}
    @process.tmpl = ${'<div class="paddingBottom-single"><h2 class="Service">' + listTitle + '</h2>' + value + '</div>'}
    items = ${q(site).find('[instanceof ' + nodeType + ']').get()}
    items.@process.filterOutSelf = ${q(value).filter('[_identifier != "' + node.identifier + '"]').get()}
    items.@process.filterByAuthor = ${q(value).filterByReference('author', author).get()}
    itemName = 'node'
    itemRenderer = Sfi.Sfi:PaperWithAuthor.TeaserForAuthorInfo
    @if.notEmpty = ${q(this.items).count() > 0}
}
