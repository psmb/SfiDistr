include: resource://Neos.Fusion/Private/Fusion/Root.fusion
include: resource://Neos.Neos/Private/Fusion/Root.fusion
include: resource://Flowpack.Listable/Private/Fusion/Root.fusion

listable.basicListing = Flowpack.Listable:Listable {
    itemRenderer = 'Flowpack.Listable:TestItem'
    paginationEnabled = false
    listClass = ''
    itemClass = ''
    collection = ${collection}
}

prototype(Flowpack.Listable:TestItem) < prototype(Neos.Fusion:Value) {
    value = ${node.properties.title}
}
