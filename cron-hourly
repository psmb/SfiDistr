#!/usr/bin/env bash
set -euo pipefail

target=/data/www-provisioned/Web/sveden/education.html
mkdir -p "$(dirname "$target")"
temporary_file=$(mktemp "${target}.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT

curl --fail --silent --show-error --max-time 600 --retry 3 \
    --output "$temporary_file" http://127.0.0.1/about/sveden/education.html
chmod 644 "$temporary_file"
mv -f "$temporary_file" "$target"
